generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model DemoUsage {
  key String @id
  count Int @default(0)
}
model Agreement {
  sellerUserId String?
  sellerInviteExpiresAt DateTime?
  sellerUser User? @relation(fields: [sellerUserId], references: [id])
  accessRequests SellerAccessRequest[]
  workspaceId String @default("local")
  id String @id @default(cuid())
  title String
  buyerName String @default("Alex Morgan")
  buyerEmail String @default("buyer@example.com")
  sellerEmail String
  sellerToken String @unique
  description String
  totalAmount Int
  currency String @default("USD")
  status String @default("ACTIVE")
  paymentMode String
  aiSource String
  riskFlags String
  deadline String?
  createdAt DateTime @default(now())
  @@index([workspaceId])
  @@index([sellerUserId])
  milestones Milestone[]
  payments PaymentEvent[]
  timeline TimelineEvent[]
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  sellerAgreements Agreement[]
  accessRequests SellerAccessRequest[]
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}

model SellerAccessRequest {
  id String @id @default(cuid())
  agreementId String
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([agreementId, userId])
}
model Milestone {
  id String @id @default(cuid())
  agreementId String
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  position Int
  title String
  description String
  acceptanceCriteria String
  amount Int
  status String @default("PENDING")
  paymentStatus String @default("UNFUNDED")
  dueDate String?
  aiRiskNotes String
  orderId String? @unique
  authorizationId String? @unique
  captureId String? @unique
  authorizedAt DateTime?
  expiresAt DateTime?
  browserPolicyJson String?
  autoCapture Boolean @default(false)
  autoCaptureUntil DateTime?
  autoCaptureLimit Int @default(0)
  agentRuns AgentRun[]
  submissions Submission[]
  payments PaymentEvent[]
  @@index([agreementId])
}
model Submission {
  id String @id @default(cuid())
  milestoneId String
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  content String
  url String?
  aiScore Int
  aiRecommendation String
  aiSource String
  aiReviewJson String
  createdAt DateTime @default(now())
  @@index([milestoneId])
}
model PaymentEvent {
  id String @id @default(cuid())
  agreementId String
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  provider String
  providerOrderId String?
  providerAuthorizationId String?
  providerCaptureId String?
  operationKey String @unique
  type String
  amount Int
  status String
  rawJson String
  createdAt DateTime @default(now())
  @@index([agreementId])
}
model TimelineEvent {
  id String @id @default(cuid())
  agreementId String
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actor String
  type String
  message String
  metadataJson String @default("{}")
  createdAt DateTime @default(now())
  @@index([agreementId])
}

model AgentRun {
  id String @id @default(cuid())
  milestoneId String
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submissionId String
  status String @default("RUNNING")
  planner String @default("pending")
  summary String @default("")
  policyJson String
  traceJson String @default("[]")
  resultJson String @default("{}")
  screenshotsJson String @default("[]")
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([milestoneId])
}
