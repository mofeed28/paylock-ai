DATABASE_URL="file:./dev.db"
# PRACTICE is an explicit, no-money local demo. Set sandbox for real PayPal sandbox calls.
PAYMENT_MODE="practice"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# Never put API keys in NEXT_PUBLIC variables.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional model override for the browser tool loop (function calling required).
OPENAI_AGENT_MODEL="gpt-4o-mini"
# Select bedrock to use native Converse for reviews and browser tool calling.
AI_PROVIDER="openai"
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Use a dedicated Bedrock API key OR the SDK IAM/profile credential chain.
AWS_BEARER_TOKEN_BEDROCK=""
# Optional judges-only deployment. Requires BUYER_ACCESS_KEY and expiry.
DEMO_MODE=""
DEMO_EXPIRES_AT="2026-12-16T00:00:00Z"
# Exact comma-separated HTTPS origins permitted for hosted browser checks.
# Empty permits only the built-in offline browser sample in judge mode.
DEMO_ALLOWED_ORIGINS=""
# Optional PLAYWRIGHT_BROWSERS_PATH; omit to use the standard Playwright cache.
# Optional shared buyer login. Required when running beyond localhost.
BUYER_ACCESS_KEY=""
APP_URL="http://localhost:3000"
