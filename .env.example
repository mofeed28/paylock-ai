DATABASE_URL="file:./dev.db"
# PRACTICE is an explicit, no-money local demo. Set sandbox for real PayPal sandbox calls.
PAYMENT_MODE="practice"
PAYPAL_ENV="sandbox"
# Separate Sandbox REST app of Type Platform (seller onboarding). Never replace
# the original merchant credentials while legacy orders/receipts still exist.
PAYPAL_PLATFORM_CLIENT_ID=""
PAYPAL_PLATFORM_CLIENT_SECRET=""
PAYPAL_PARTNER_MERCHANT_ID=""
PAYPAL_PARTNER_BN_CODE=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# Never put API keys in NEXT_PUBLIC variables.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional model override for the browser tool loop (function calling required).
OPENAI_AGENT_MODEL="gpt-4o-mini"
# Select bedrock to use native Converse for reviews and browser tool calling.
AI_PROVIDER="openai"
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.amazon.nova-2-lite-v1:0"
# Use a dedicated Bedrock API key OR the SDK IAM/profile credential chain.
AWS_BEARER_TOKEN_BEDROCK=""
# Optional judges-only deployment. Requires BUYER_ACCESS_KEY and expiry.
DEMO_MODE=""
DEMO_EXPIRES_AT="2026-12-16T00:00:00Z"
# Optional AI call ceilings for hosted judge/account deployments (defaults: 150/month, 20/workspace/day).
DEMO_MONTHLY_MODEL_LIMIT="150"
DEMO_DAILY_WORKSPACE_LIMIT="20"
# Exact comma-separated HTTPS origins permitted for hosted browser checks.
# Empty permits only the built-in offline browser sample in judge mode.
DEMO_ALLOWED_ORIGINS=""
# Optional owned public storefront to prefill the sandbox verification form.
# Its origin must also appear in DEMO_ALLOWED_ORIGINS.
DEMO_WEBSITE_URL=""
# Optional PLAYWRIGHT_BROWSERS_PATH; omit to use the standard Playwright cache.
# Optional shared buyer login. Required when running beyond localhost.
BUYER_ACCESS_KEY=""
APP_URL="http://localhost:3000"
# Optional permanent private-beta accounts. Run migrations before enabling.
# BUYER_ACCESS_KEY becomes the signup enrollment code; sign-in uses each user's password.
AUTH_MODE=""
# Generate a separate random 32+ character secret. Keep server-side only.
BETTER_AUTH_SECRET=""
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
AUTH_TRUST_PROXY="false"
