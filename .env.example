DATABASE_URL="file:./dev.db"
# PRACTICE is an explicit, no-money local demo. Set sandbox for real PayPal sandbox calls.
PAYMENT_MODE="practice"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# Never put API keys in NEXT_PUBLIC variables.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional shared buyer login. Required when running beyond localhost.
BUYER_ACCESS_KEY=""
APP_URL="http://localhost:3000"
