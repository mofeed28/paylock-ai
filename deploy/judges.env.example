# Copy to /etc/paylock.env on the demo host; never commit populated values.
NODE_ENV=production
DATABASE_URL=file:/var/lib/paylock/demo.db
APP_URL=https://YOUR_DEMO_HOSTNAME
DEMO_MODE=judges
DEMO_EXPIRES_AT=2026-12-16T00:00:00Z
BUYER_ACCESS_KEY=REPLACE_WITH_A_RANDOM_JUDGE_ACCESS_CODE_AT_LEAST_24_CHARACTERS
PAYMENT_MODE=sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEARER_TOKEN_BEDROCK=
PLAYWRIGHT_BROWSERS_PATH=/opt/paylock-browsers
# Default: browser access only to the bundled fixture, no arbitrary websites.
DEMO_ALLOWED_ORIGINS=
